# Copy to .env and fill in. Never commit .env.
# Use a dedicated Eufy account that the owner account has shared the lock with,
# so this service does not log the phone app out.
EUFY_USERNAME=
EUFY_PASSWORD=
# Two-letter country code of the Eufy account (US, CA, GB, ...)
EUFY_COUNTRY=US
EUFY_LANGUAGE=en
# Seconds to listen for live events after discovery
POC_LISTEN_SECONDS=120
