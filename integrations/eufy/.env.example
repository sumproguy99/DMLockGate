# Copy to .env and fill in. Never commit .env.
# Use a dedicated Eufy account that the owner account has shared the lock with,
# so this service does not log the phone app out.
EUFY_USERNAME=
EUFY_PASSWORD=
# Two-letter country code of the Eufy account (US, CA, GB, ...)
EUFY_COUNTRY=US
EUFY_LANGUAGE=en
# Seconds to listen for live events after discovery
POC_LISTEN_SECONDS=120

# --- Bridge (npm run bridge) ---
# Shared with LockGuard's LOCKGUARD_BRIDGE_SECRET. At least 32 random characters.
LOCKGUARD_BRIDGE_SECRET=
# Keep the bridge on loopback unless LockGuard runs on another machine.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# LockGuard's internal webhook for lock events.
LOCKGUARD_EVENTS_URL=http://127.0.0.1:8000/api/internal/eufy/events
# Broker instance that holds the locks' own MQTT session. Commands sent through any other instance
# are accepted and silently dropped. Find it with `npm run diag:listen -- "<lock name>"` while
# operating the lock from the Eufy app. Empty = the SDK's own choice (first DNS answer).
EUFY_MQTT_BROKER_IP=
