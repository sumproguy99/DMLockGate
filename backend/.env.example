APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DM LockGuard
LOCKGUARD_STEP_UP_SECONDS=600
LOCKGUARD_MFA_ISSUER="DM LockGuard"
# unconfigured (safe default: nothing is sent), fake (simulated lock, development only), eufy_bridge
LOCKGUARD_LOCK_DRIVER=unconfigured
LOCKGUARD_COMMAND_TTL_SECONDS=30
LOCKGUARD_CONFIRM_TIMEOUT_SECONDS=45
LOCKGUARD_CONFIRM_POLL_SECONDS=5
LOCKGUARD_POLL_LAG_SECONDS=15
LOCKGUARD_STATE_STALE_SECONDS=900
# standard, step_up, location_required, disabled
LOCKGUARD_REMOTE_UNLOCK_POLICY=step_up
# Used when LOCKGUARD_LOCK_DRIVER=eufy_bridge. The secret must match the bridge's (32+ random characters).
LOCKGUARD_BRIDGE_URL=http://127.0.0.1:8788
LOCKGUARD_BRIDGE_SECRET=
# Location map: records older than this are deleted daily; a location request waits this long for the phone.
LOCKGUARD_LOCATION_RETENTION_DAYS=30
LOCKGUARD_LOCATION_REQUEST_TTL_SECONDS=120
# Security alerts (config/lockguard.php, alerts): how many matching events in how many minutes raise an alert.
LOCKGUARD_ALERT_FAILED_SIGN_INS=5
LOCKGUARD_ALERT_FAILED_SIGN_INS_MINUTES=15
LOCKGUARD_ALERT_DENIED_REQUESTS=3
LOCKGUARD_ALERT_DENIED_REQUESTS_MINUTES=15
LOCKGUARD_ALERT_COMMAND_FAILURES=3
LOCKGUARD_ALERT_COMMAND_FAILURES_MINUTES=30
LOCKGUARD_ALERT_BATTERY_LOW_PERCENT=25
LOCKGUARD_ALERT_BATTERY_CRITICAL_PERCENT=10
LOCKGUARD_ALERT_QUIET_HOURS=24
LOCKGUARD_ALERT_REOPEN_MINUTES=60
LOCKGUARD_NOTIFICATIONS_PER_HOUR=20
# Devices (config/lockguard.php, devices). Each browser is recognized by an HTTP-only cookie.
LOCKGUARD_DEVICE_COOKIE=lockguard_device
LOCKGUARD_DEVICE_COOKIE_DAYS=400
# true = unlocking needs a device the user has trusted (locking never does).
LOCKGUARD_UNLOCK_REQUIRES_TRUSTED_DEVICE=false
# Device binding: everyone without an exempt role can only use LockGuard on the one device they
# registered with a one-time code (user page > Devices, or php artisan lockguard:device-code EMAIL).
LOCKGUARD_DEVICE_BINDING=true
LOCKGUARD_DEVICE_BINDING_EXEMPT_ROLES=super_administrator,security_administrator
LOCKGUARD_DEVICE_CODE_HOURS=24
# Accounts locked to network addresses instead of a device (no code; any other address is refused),
# e.g. an unattended kiosk. Format: email=address|address;email=address (CIDR ranges allowed).
LOCKGUARD_DEVICE_ADDRESS_ACCOUNTS=
# Proxies whose X-Forwarded-For is believed (the Vite dev server on this machine). CIDR allowed.
LOCKGUARD_TRUSTED_PROXIES=127.0.0.1,::1
# Web app origins allowed to sign in (cookie sessions): local dev (5173), the built app (4173) and
# the public address Nginx Proxy Manager serves. A public deployment also needs APP_DEBUG=false.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:4173,127.0.0.1,127.0.0.1:5173,127.0.0.1:4173,::1,lockguard.dmfmedia.net
